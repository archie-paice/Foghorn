# Foghorn server on Linux (systemd). See docs/INSTALL-SERVER.md, "Appendix A - Installing on Linux".
# Foghorn was designed and built by Archie Paice <hello@archiepaice.com>.
[Unit]
Description=Foghorn alert server
After=network-online.target
Wants=network-online.target

[Service]
User=foghorn
Group=foghorn
# The program lives inside the data folder so the console's "Update server"
# can replace it (docs/UPDATING.md). It then exits with status 3 and
# Restart=on-failure starts the new version.
ExecStart=/var/lib/foghorn/bin/foghorn-server run -data /var/lib/foghorn
Restart=on-failure
RestartSec=5
# hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/foghorn
StateDirectory=foghorn
StateDirectoryMode=0750

[Install]
WantedBy=multi-user.target
