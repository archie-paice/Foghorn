<?xml version="1.0" encoding="utf-8"?>
<!-- Foghorn client MSI. Build it with deploy/msi/build-msi.sh (Linux, msitools) - NOT with wixl on its own:
     the script applies two post-build tweaks wixl cannot express, and a build without them is broken
     for managed deployment. See docs/BUILDING.md.
     Optional install-time settings:  msiexec /i FoghornClient.msi /qn SERVERURL=http://foghorn01:8080 CLIENTKEY=...
     If they are left out, empty values are written and the client ignores them, taking its
     settings from Group Policy (Foghorn.admx) instead - which is the recommended way with an MSI.  -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Foghorn Client" Language="1033" Version="1.1.0" Manufacturer="Archie Paice"
           UpgradeCode="7B0E5C0A-6E0B-4B7E-9C55-5A1C1F0D7A11">
    <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine"
             Description="Foghorn desktop alert client" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of the Foghorn client is already installed." />
    <Media Id="1" Cabinet="foghorn.cab" EmbedCab="yes" />
    <Property Id="SERVERURL" Secure="yes" />
    <Property Id="CLIENTKEY" Secure="yes" />
    <Property Id="USESYSTEMPROXY" Secure="yes" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <!-- Shown alongside the entry in Apps and Features, so an administrator can
         see who wrote this and how to reach them. Manufacturer above is the
         Publisher column. -->
    <Property Id="ARPCONTACT" Value="Archie Paice" />
    <Property Id="ARPHELPLINK" Value="mailto:hello@archiepaice.com" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="Foghorn">
          <Component Id="ClientExe" Guid="3E0F3D8B-1C57-4E63-8E0C-0D7A1B2C9F01" Win64="yes">
            <File Id="FoghornClientExe" Name="FoghornClient.exe" Source="../../dist/FoghornClient.exe" KeyPath="yes" />
          </Component>
          <Component Id="RunAtLogon" Guid="3E0F3D8B-1C57-4E63-8E0C-0D7A1B2C9F02" Win64="yes">
            <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run" Name="FoghornClient"
                           Type="string" Value="&quot;[INSTALLDIR]FoghornClient.exe&quot;" KeyPath="yes" />
          </Component>
          <Component Id="Settings" Guid="3E0F3D8B-1C57-4E63-8E0C-0D7A1B2C9F03" Win64="yes">
            <RegistryKey Root="HKLM" Key="SOFTWARE\Foghorn">
              <RegistryValue Name="ServerUrl" Type="string" Value="[SERVERURL]" KeyPath="yes" />
              <RegistryValue Name="ClientKey" Type="string" Value="[CLIENTKEY]" />
              <RegistryValue Name="UseSystemProxy" Type="string" Value="[USESYSTEMPROXY]" />
            </RegistryKey>
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <Feature Id="Main" Title="Foghorn Client" Level="1">
      <ComponentRef Id="ClientExe" />
      <ComponentRef Id="RunAtLogon" />
      <ComponentRef Id="Settings" />
    </Feature>
  </Product>
</Wix>
